# Copy to .env and fill in. Never commit the filled-in file.
#
# Generate each secret separately:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

AISH_ENV=production
AISH_PUBLIC_HOST=aish.devalier.com

# Signs session cookies and CSRF tokens.
AISH_SECRET_KEY=

# Wraps stored provider API keys (AES-256-GCM). MUST differ from AISH_SECRET_KEY:
# rotating the cookie key must not destroy every stored credential.
AISH_ENCRYPTION_KEY=

AISH_DATABASE_URL=sqlite:////data/aish.db

# Optional: restrict registration to institutional domains (comma separated).
# AISH_ALLOWED_EMAIL_DOMAINS=ec.europa.eu,europarl.europa.eu

# Optional: hold new accounts until an administrator approves them.
# The first account created is the administrator and is always approved.
AISH_REQUIRE_ADMIN_APPROVAL=false

# On-prem models live on private networks, so private ranges are reachable by
# default. Loopback, link-local and cloud metadata addresses are always refused.
AISH_ALLOW_PRIVATE_ENDPOINTS=true

AISH_MAX_CONCURRENT_REQUESTS=4
AISH_MAX_ITEMS_PER_RUN=500
